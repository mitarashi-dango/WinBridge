<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WinBridge.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\WinBridge.csproj" />
    <None Include="..\..\Resources\SettingDefinitions.json"
          Link="Resources\SettingDefinitions.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\ModuleDefinitions.json"
          Link="Resources\ModuleDefinitions.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\Strings.en-US.json"
          Link="Resources\Strings.en-US.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Views\*.xaml"
          Link="Views\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\WinBridge.iss"
          Link="ReleaseFiles\WinBridge.iss"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\package-release.ps1"
          Link="ReleaseFiles\package-release.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\app.manifest"
          Link="ReleaseFiles\app.manifest"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
