<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WinBridge.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\WinBridge.csproj" />
    <None Include="..\..\Resources\SettingDefinitions.json"
          Link="Resources\SettingDefinitions.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\ModuleDefinitions.json"
          Link="Resources\ModuleDefinitions.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\Strings.en-US.json"
          Link="Resources\Strings.en-US.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\Strings.es-ES.json"
          Link="Resources\Strings.es-ES.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\Strings.zh-CN.json"
          Link="Resources\Strings.zh-CN.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Resources\Strings.zh-TW.json"
          Link="Resources\Strings.zh-TW.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Views\*.xaml"
          Link="Views\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Services\PowerPolicyAccessor.cs"
          Link="SourceFiles\Services\PowerPolicyAccessor.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Services\PowerSettingsService.cs"
          Link="SourceFiles\Services\PowerSettingsService.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Services\PowerPresetService.cs"
          Link="SourceFiles\Services\PowerPresetService.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ViewModels\PowerViewModel.cs"
          Link="SourceFiles\ViewModels\PowerViewModel.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\WinBridge.iss"
          Link="ReleaseFiles\WinBridge.iss"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\package-release.ps1"
          Link="ReleaseFiles\package-release.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\app.manifest"
          Link="ReleaseFiles\app.manifest"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\packaging\msix\AppxManifest.template.xml"
          Link="ReleaseFiles\AppxManifest.template.xml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
