<UserControl x:Class="WinBridge.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinBridge.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" IsEnabled="{Binding IsInteractionEnabled}">
      <TextBlock Text="{loc:Loc '画面とスリープ'}" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc 'Windowsで現在有効な電源プランの値を表示します。'}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{loc:Loc 'プリセット'}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <WrapPanel>
            <Button Content="{loc:Loc '集中作業'}" Command="{Binding PresetCommand}" CommandParameter="focus"/>
            <Button Content="{loc:Loc '普段使い'}" Command="{Binding PresetCommand}" CommandParameter="normal"/>
            <Button Content="{loc:Loc '省電力'}" Command="{Binding PresetCommand}" CommandParameter="saving"/>
            <Button Content="{loc:Loc 'お好み'}" Command="{Binding PresetCommand}" CommandParameter="custom"/>
          </WrapPanel>
          <TextBlock Text="{loc:Loc '選択だけでは変更されません。下の「設定を適用」を押すと反映されます。'}" Foreground="{StaticResource MutedBrush}" Margin="4,6,0,0"/>
          <Button Content="{loc:Loc '現在の選択をお好みに保存'}" Command="{Binding SaveCustomPresetCommand}"
                  HorizontalAlignment="Left" Margin="4,10,0,0"/>
          <TextBlock Text="{loc:Loc '時間を選んで保存すると、次回から「お好み」で呼び出せます。保存だけではWindowsの設定は変わりません。'}"
                     Foreground="{StaticResource MutedBrush}" Margin="4,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid x:Name="TimeoutGrid" SizeChanged="TimeoutGrid_SizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition>
              <ColumnDefinition.Style>
                <Style TargetType="ColumnDefinition">
                  <Setter Property="Width" Value="*"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasBattery}" Value="False">
                      <Setter Property="Width" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ColumnDefinition.Style>
            </ColumnDefinition>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="AcSettings">
            <TextBlock Text="{loc:Loc '電源に接続時'}" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="AcDisplayLabel" Text="{loc:Loc '画面をオフにするまで'}" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding DisplayChoices}" SelectedItem="{Binding AcDisplay}" MinHeight="34"
                      AutomationProperties.LabeledBy="{Binding ElementName=AcDisplayLabel}"/>
            <TextBlock x:Name="AcSleepLabel" Text="{loc:Loc 'スリープ状態にするまで'}" Margin="0,12,0,5"/>
            <ComboBox ItemsSource="{Binding SleepChoices}" SelectedItem="{Binding AcSleep}" MinHeight="34"
                      AutomationProperties.LabeledBy="{Binding ElementName=AcSleepLabel}"/>
          </StackPanel>
          <StackPanel x:Name="BatterySettings" Grid.Column="1" Margin="20,0,0,0"
                      Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Loc 'バッテリー使用時'}" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="DcDisplayLabel" Text="{loc:Loc '画面をオフにするまで'}" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding DisplayChoices}" SelectedItem="{Binding DcDisplay}" MinHeight="34"
                      AutomationProperties.LabeledBy="{Binding ElementName=DcDisplayLabel}"/>
            <TextBlock x:Name="DcSleepLabel" Text="{loc:Loc 'スリープ状態にするまで'}" Margin="0,12,0,5"/>
            <ComboBox ItemsSource="{Binding SleepChoices}" SelectedItem="{Binding DcSleep}" MinHeight="34"
                      AutomationProperties.LabeledBy="{Binding ElementName=DcSleepLabel}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{loc:Loc '画面OFF'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc 'モニターだけを暗くします。アプリやダウンロードなど、PC内部の処理は継続します。'}" Margin="0,3,0,12"/>
          <TextBlock Text="{loc:Loc 'スリープ'}" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc 'PCの動作を一時停止し、消費電力を抑えます。'}" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <WrapPanel>
        <Button Content="{loc:Loc '現在値を再読み込み'}" Command="{Binding RefreshCommand}"/>
        <Button Content="{loc:Loc '設定を適用'}" Command="{Binding ApplyCommand}" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
