<UserControl x:Class="WinBridge.Views.SettingsCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinBridge.Localization">
  <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
      <TextBlock Text="{loc:Loc 'Windows設定を追加・整理'}" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc 'よく使う設定を選ぶと、ホームと左メニューからすぐ開けます。外してもWindowsの設定自体は変わりません。'}"
                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>

      <TextBlock Text="{loc:Loc '使用中の設定'}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock Text="{loc:Loc 'まだ設定が追加されていません。下のカタログから追加できます。'}"
                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedSettings.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <ListBox x:Name="SelectedList" ItemsSource="{Binding SelectedSettings}"
               Background="Transparent" BorderThickness="0" AllowDrop="True"
               PreviewMouseWheel="NestedList_PreviewMouseWheel"
               PreviewMouseLeftButtonDown="SelectedList_PreviewMouseLeftButtonDown"
               PreviewMouseMove="SelectedList_PreviewMouseMove" Drop="SelectedList_Drop">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="45"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontSize="25" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="3,0,12,0">
                  <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6">
                  <CheckBox Content="{loc:Loc '★ お気に入り'}" IsChecked="{Binding IsFavorite}"
                            Click="SettingOptionCheckBox_Click" Margin="0,2"/>
                  <CheckBox Content="{loc:Loc '左メニューに固定'}" IsChecked="{Binding IsPinned}"
                            Click="SettingOptionCheckBox_Click" Margin="0,5,0,2"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="↑" ToolTip="{loc:Loc '上へ'}"
                          Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"/>
                  <Button Content="↓" ToolTip="{loc:Loc '下へ'}"
                          Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"/>
                  <Button Content="{loc:Loc '外す'}"
                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Separator Margin="0,12,0,20"/>
      <TextBlock Text="{loc:Loc '追加できる設定'}" FontSize="21" FontWeight="SemiBold"/>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,10,0,16" Padding="12,9" MinWidth="360"
               ToolTip="{loc:Loc '設定名や用途で検索'}" AutomationProperties.Name="{loc:Loc '設定を検索'}"/>
      <ListBox ItemsSource="{Binding AvailableSettingsView}" Background="Transparent" BorderThickness="0"
               PreviewMouseWheel="NestedList_PreviewMouseWheel">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="#DCE3EC" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,7">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontSize="23" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{loc:Loc '追加'}"
                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{loc:Loc 'WinBridgeで確認済みのWindows正規設定画面だけを表示します。機器依存の設定は、このPCで対応機器を検出した場合のみ表示されます。'}"
                 Foreground="{StaticResource MutedBrush}" Margin="0,14,0,24"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
