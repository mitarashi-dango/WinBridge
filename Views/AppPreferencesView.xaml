<UserControl x:Class="WinBridge.Views.AppPreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinBridge.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
      <TextBlock Text="{loc:Loc 'WinBridge の設定'}" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc 'アプリの表示方法と開発支援について設定・確認できます。Windowsの設定は変更しません。'}"
                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{loc:Loc '表示言語'}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc '「Windowsの表示言語に合わせる」では、対応している言語を自動的に選び、それ以外の環境では英語を表示します。'}"
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
          <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedLanguage}" Width="330"
                    HorizontalAlignment="Left" MinHeight="36" Padding="8,4"/>
          <TextBlock Text="{loc:Loc '変更はWinBridgeの再起動後に反映されます。'}"
                     Foreground="{StaticResource MutedBrush}" Margin="0,10,0,10"/>
          <Button Content="{loc:Loc '言語設定を保存'}" Command="{Binding SaveCommand}"
                  HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                  Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" DataContext="{Binding Updates}">
        <StackPanel>
          <TextBlock Text="{loc:Loc 'WinBridgeの更新'}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SourceDescription}" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
          <CheckBox IsChecked="{Binding AutoCheck, Mode=OneWay}" Command="{Binding ToggleAutoCheckCommand}">
            <TextBlock Text="{loc:Loc '起動時に更新を自動確認する'}" TextWrapping="Wrap"/>
          </CheckBox>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,8"
                     AutomationProperties.LiveSetting="Polite"/>
          <WrapPanel>
            <Button Content="{loc:Loc '今すぐ更新を確認'}" Command="{Binding CheckCommand}"/>
            <Button Content="{loc:Loc '更新ページを開く'}" Command="{Binding OpenUpdateCommand}"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="{loc:Loc 'WinBridgeの開発を支援'}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc 'WinBridgeはすべての機能を無料で利用できます。気に入っていただけたら、今後の開発を任意で応援していただけるとうれしいです。'}"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/>
          <TextBlock Text="{loc:Loc '支援の有無による機能差や特典はありません。'}"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button Content="{loc:Loc 'Ko-fiで開発を支援'}" Command="{Binding OpenSupportPageCommand}"
                  HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                  Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc '外部のKo-fiページがブラウザーで開き、Ko-fiまたはPayPalが決済を処理します。'}"
                     Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
