<UserControl x:Class="WinBridge.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
      <TextBlock Text="エクスプローラー" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="ファイルの見え方と、安全な復旧操作をまとめています。" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="ファイル表示" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <CheckBox Content="ファイル名拡張子を表示する" IsChecked="{Binding ShowExtensions}" Padding="4" Margin="0,6"/>
          <TextBlock Text="例: 写真.jpg の「.jpg」部分を表示します。" Foreground="{StaticResource MutedBrush}" Margin="25,0,0,8"/>
          <CheckBox Content="隠しファイルを表示する" IsChecked="{Binding ShowHidden}" Padding="4" Margin="0,6"/>
          <TextBlock Text="Windowsが通常隠している項目も表示します。システムファイルの表示設定は変更しません。" Foreground="{StaticResource MutedBrush}" Margin="25,0,0,12"/>
          <WrapPanel>
            <Button Content="表示設定を適用" Command="{Binding ApplyCommand}" Background="{StaticResource AccentBrush}" Foreground="White"/>
            <Button Content="現在値を再読み込み" Command="{Binding RefreshCommand}"/>
            <Button Content="元に戻す" Command="{Binding UndoCommand}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="よく使う画面" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <WrapPanel>
            <Button Content="エクスプローラーを開く" Command="{Binding OpenCommand}" CommandParameter="explorer"/>
            <Button Content="フォルダー オプション" Command="{Binding OpenCommand}" CommandParameter="folders"/>
            <Button Content="ストレージ設定" Command="{Binding OpenCommand}" CommandParameter="ms-settings:storage"/>
            <Button Content="一時ファイルを確認（ストレージ）" Command="{Binding OpenCommand}" CommandParameter="ms-settings:storagesense"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="動作がおかしいとき" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="タスクバーやデスクトップを含むエクスプローラーを一度終了し、再び起動します。実行前に確認します。" Margin="0,8"/>
          <Button Content="エクスプローラーを再起動" Command="{Binding RestartCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
