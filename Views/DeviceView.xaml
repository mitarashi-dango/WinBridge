<UserControl x:Class="WinBridge.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="840" HorizontalAlignment="Left">
      <TextBlock Text="デバイスと接続" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="接続機器の状態と、Windowsの正規設定画面を1か所にまとめています。"
                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="デバイスの状態" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Margin="0,8,15,0" LineHeight="22"/>
          </StackPanel>
          <Button Grid.Column="1" Content="再確認" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="デバイス全般" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="認識されない機器やドライバーの状態を確認できます。WinBridgeから無効化や削除は行いません。"
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
          <WrapPanel>
            <Button Content="デバイスマネージャー" Command="{Binding OpenCommand}" CommandParameter="device-manager"/>
            <Button Content="接続済みデバイス" Command="{Binding OpenCommand}" CommandParameter="ms-settings:connecteddevices"/>
            <Button Content="オプションの更新" Command="{Binding OpenCommand}" CommandParameter="ms-settings:windowsupdate-optionalupdates"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,14">
          <StackPanel>
            <TextBlock Text="Bluetooth" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="機器の追加、接続状態、Bluetoothのオン・オフをWindowsで確認します。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
            <Button Content="Bluetooth設定を開く" Command="{Binding OpenCommand}"
                    CommandParameter="ms-settings:bluetooth" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,14">
          <StackPanel>
            <TextBlock Text="プリンター" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="プリンターやスキャナーの追加、既定値、印刷キューを確認します。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
            <Button Content="プリンター設定を開く" Command="{Binding OpenCommand}"
                    CommandParameter="ms-settings:printers" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,14">
          <StackPanel>
            <TextBlock Text="USB" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="USB機器の接続通知や、接続に問題がある場合の通知設定を確認します。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
            <Button Content="USB設定を開く" Command="{Binding OpenCommand}"
                    CommandParameter="ms-settings:usb" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,14">
          <StackPanel>
            <TextBlock Text="カメラ" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="接続されたカメラの映像、明るさ、既定設定をWindowsで確認します。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
            <Button Content="カメラ設定を開く" Command="{Binding OpenCommand}"
                    CommandParameter="ms-settings:camera" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,14">
          <StackPanel>
            <TextBlock Text="マウス" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="主に使うボタン、ポインター速度、スクロール量をWindowsで調整します。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
            <Button Content="マウス設定を開く" Command="{Binding OpenCommand}"
                    CommandParameter="ms-settings:mousetouchpad" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,14">
          <StackPanel>
            <TextBlock Text="マイク" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="既定の入力マイク、音量、アプリからのアクセス許可をWindowsで確認します。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
            <WrapPanel>
              <Button Content="入力マイク設定" Command="{Binding OpenCommand}"
                      CommandParameter="ms-settings:sound-defaultinputproperties"/>
              <Button Content="マイクのアクセス許可" Command="{Binding OpenCommand}"
                      CommandParameter="ms-settings:privacy-microphone"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="安全について" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Margin="0,7,0,0" LineHeight="22"
                     Text="この画面はデバイス状態を読み取り、Windowsの正規画面を開くだけです。ドライバーの強制更新・削除、デバイスの無効化、問題機器の一括修復は行いません。"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
