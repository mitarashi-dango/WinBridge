<UserControl x:Class="WinBridge.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinBridge.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
      <TextBlock Text="Windows Update" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc '更新を無効化せず、Windowsの正規画面へ安全に案内します。'}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{Binding UpdateStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="{loc:Loc '正確な更新状況と最終確認日時は、Windows Update画面で確認してください。'}" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <Button Content="{loc:Loc '更新を確認する画面を開く'}" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="ms-settings:windowsupdate"/>
          <Button Content="{loc:Loc '更新履歴を開く'}" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="ms-settings:windowsupdate-history"/>
          <Button Content="{loc:Loc '再起動の設定を開く'}" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="ms-settings:windowsupdate-restartoptions"/>
          <Button Content="{loc:Loc 'アクティブ時間を設定'}" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="ms-settings:windowsupdate-activehours"/>
          <Button Content="{loc:Loc '更新の一時停止を設定'}" HorizontalContentAlignment="Left" Command="{Binding OpenCommand}" CommandParameter="ms-settings:windowsupdate-options"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
