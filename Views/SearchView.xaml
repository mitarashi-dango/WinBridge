<UserControl x:Class="WinBridge.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="スタートと検索" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ServiceStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
      <Border Style="{StaticResource CardStyle}">
        <WrapPanel>
          <Button Content="Windows検索設定" Command="{Binding OpenCommand}" CommandParameter="ms-settings:search"/>
          <Button Content="検索対象フォルダー" Command="{Binding OpenCommand}" CommandParameter="ms-settings:searchingwindows"/>
          <Button Content="インデックス設定" Command="{Binding OpenCommand}" CommandParameter="indexing"/>
          <Button Content="スタート設定" Command="{Binding OpenCommand}" CommandParameter="ms-settings:personalization-start"/>
          <Button Content="既定のアプリ" Command="{Binding OpenCommand}" CommandParameter="ms-settings:defaultapps"/>
        </WrapPanel>
      </Border>
      <TextBlock Text="どの問題がありますか？" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,8"/>
      <WrapPanel>
        <Button Content="検索してもファイルが出ない" Command="{Binding GuidanceCommand}" CommandParameter="missing"/>
        <Button Content="検索結果が古い" Command="{Binding GuidanceCommand}" CommandParameter="old"/>
        <Button Content="検索が遅い" Command="{Binding GuidanceCommand}" CommandParameter="slow"/>
        <Button Content="PC内を探したい" Command="{Binding GuidanceCommand}" CommandParameter="local"/>
        <Button Content="スタートの表示を変えたい" Command="{Binding GuidanceCommand}" CommandParameter="start"/>
      </WrapPanel>
      <Border Style="{StaticResource CardStyle}" Margin="0,12,0,14">
        <StackPanel>
          <TextBlock Text="確認手順" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Guidance}" LineHeight="24"/>
        </StackPanel>
      </Border>
      <TextBlock Text="WinBridgeはインデックスの再構築、サービス停止、レジストリやグループポリシーの変更を自動実行しません。"
                 Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
