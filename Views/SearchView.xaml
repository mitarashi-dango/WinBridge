<UserControl x:Class="WinBridge.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinBridge.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
      <TextBlock Text="{loc:Loc 'スタートと検索'}" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ServiceStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
      <Border Style="{StaticResource CardStyle}">
        <WrapPanel>
          <Button Content="{loc:Loc 'Windows検索設定'}" Command="{Binding OpenCommand}" CommandParameter="ms-settings:search"/>
          <Button Content="{loc:Loc '検索のアクセス許可'}" Command="{Binding OpenCommand}" CommandParameter="ms-settings:search-permissions"/>
          <Button Content="{loc:Loc 'インデックス設定'}" Command="{Binding OpenCommand}" CommandParameter="indexing"/>
          <Button Content="{loc:Loc 'スタート設定'}" Command="{Binding OpenCommand}" CommandParameter="ms-settings:personalization-start"/>
          <Button Content="{loc:Loc '既定のアプリ'}" Command="{Binding OpenCommand}" CommandParameter="ms-settings:defaultapps"/>
        </WrapPanel>
      </Border>
      <TextBlock Text="{loc:Loc 'どの問題がありますか？'}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,8"/>
      <WrapPanel>
        <Button Content="{loc:Loc '検索してもファイルが出ない'}" Command="{Binding GuidanceCommand}" CommandParameter="missing"/>
        <Button Content="{loc:Loc '検索結果が古い'}" Command="{Binding GuidanceCommand}" CommandParameter="old"/>
        <Button Content="{loc:Loc '検索が遅い'}" Command="{Binding GuidanceCommand}" CommandParameter="slow"/>
        <Button Content="{loc:Loc 'PC内を探したい'}" Command="{Binding GuidanceCommand}" CommandParameter="local"/>
        <Button Content="{loc:Loc 'スタートの表示を変えたい'}" Command="{Binding GuidanceCommand}" CommandParameter="start"/>
      </WrapPanel>
      <Border Style="{StaticResource CardStyle}" Margin="0,12,0,14">
        <StackPanel>
          <TextBlock Text="{loc:Loc '確認手順'}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Guidance}" LineHeight="24" TextWrapping="Wrap"/>
          <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowEverything, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Loc 'ファイル名から探す場合は、無料の検索ツール「Everything」も利用できます。Windows検索の修復や文書の内容検索とは用途が異なります。'}" TextWrapping="Wrap" LineHeight="24"/>
            <Button Content="{loc:Loc 'Everythingの公式サイトを開く'}" Command="{Binding OpenEverythingCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{loc:Loc 'WinBridgeはインデックスの再構築、サービス停止、レジストリやグループポリシーの変更を自動実行しません。'}"
                 Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
