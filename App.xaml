<Application x:Class="WinBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinBridge.ViewModels"
             xmlns:views="clr-namespace:WinBridge.Views">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PageBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6B7A"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="BorderBrush" Value="#DCE3EC"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PowerViewModel}"><views:PowerView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:WindowsUpdateViewModel}"><views:WindowsUpdateView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExplorerViewModel}"><views:ExplorerView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeviceViewModel}"><views:DeviceView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModuleSettingsViewModel}"><views:ModuleSettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsCatalogViewModel}"><views:SettingsCatalogView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AppPreferencesViewModel}"><views:AppPreferencesView/></DataTemplate>
  </Application.Resources>
</Application>
